# ============================================================
# Credenciais do laboratório. Já vem tudo preenchido — os alunos
# não precisam mexer aqui, só rodar `docker compose up`.
# ============================================================

COMPOSE_PROJECT_NAME=data_lakehouse_101

# ---- MinIO (armazenamento S3-compatível) ----
# MinIO exige senha de root com pelo menos 8 caracteres — por isso
# "trilha123" em vez de só "trilha".
MINIO_ROOT_USER=trilha
MINIO_ROOT_PASSWORD=trilha123
# Nome do bucket S3 — proposital NÃO renomeado junto com o resto do
# projeto (repositório, containers etc.): é um identificador da camada
# de dados, não do projeto em si. Mudar isso exigiria recriar o bucket
# e reconstruir tudo que estiver nele (rodar os notebooks de novo);
# sem motivo pra fazer isso numa troca de nome.
MINIO_BUCKET=lakehouse

# ---- Jupyter ----
# Sem token/senha, de propósito (ver `command:` do serviço jupyter no
# docker-compose.yml) — abre direto em /lab, sem tela de login. Só é
# seguro porque a porta 8888 não deveria ficar exposta pra fora da
# máquina do aluno; ver README.
